{
  "name": "air-quality-app",
  "version": "1.2.1",
  "type": "module",
  "augmentos": {
    "versionDisplay": "Air Quality v1.2.1",
    "websocket": true
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js",
    "start": "bun --smol run ./dist/index.js", 
    "dev": "bun --hot src/index.ts",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml -p dev up",
    "test:connect": "bun test-websocket.ts"
  },
  "dependencies": {
    "@augmentos/sdk": "1.1.4",
    "axios": "1.8.4",
    "dotenv": "16.5.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}