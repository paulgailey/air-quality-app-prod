    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@augmentos/sdk": "1.1.5",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "itty-router": "^5.0.18",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250505.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "jsonwebtoken": "9.0.2"
  }
}