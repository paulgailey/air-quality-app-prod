{
  "name": "air-quality-app",
  "version": "1.2.1",
  "type": "module",
  "engines": {
    "node": "16.x"
  },
  "augmentos": {
    "versionDisplay": "Air Quality v1.2.1",
    "websocket": true
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js",
    "start": "bun --smol run ./dist/index.js",
    "dev": "bun --hot src/index.ts"
  },
  "dependencies": {
    "@augmentos/sdk": "1.1.4",
    "axios": "1.8.4",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}