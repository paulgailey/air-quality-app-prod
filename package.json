{
  "name": "air-quality-app-prod2",
  "version": "2.0.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
   "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm",
    "start": "wrangler dev",
