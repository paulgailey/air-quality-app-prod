{
  "name": "air-quality-app-prod",
  "version": "2.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm",
    "start": "bun run ./dist/index.js",
