{
  "name": "air-quality-app-prod",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node",
    "start": "bun run ./dist/index.js",
    "dev": "bun --watch run ./src/index.ts",
    "prebuild": "rm -rf ./dist"
  },
  "dependencies": {
    "@augmentos/sdk": "^1.1.4",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "bun": {
    "install": {
      "exclude": ["util-deprecate"]
    }
  }
}