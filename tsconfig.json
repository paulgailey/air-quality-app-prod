{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@augmentos/sdk": ["node_modules/@augmentos/sdk/dist/index.js"],
      "@augmentos/sdk/*": ["node_modules/@augmentos/sdk/dist/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "outDir": "./dist",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}